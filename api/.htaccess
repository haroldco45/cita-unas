# Protege los archivos que no deben verse desde internet
<FilesMatch "^(config\.php|schema\.sql)$">
  Require all denied
</FilesMatch>
Options -Indexes

# Deja pasar el encabezado Authorization a PHP (necesario en algunos Hostinger)
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
